# ============================================================
# DeskForge — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Backend vars go in apps/api/.env
# Frontend vars go in apps/web/.env.local
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
APP_CORS_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://deskforge:password@localhost:5432/deskforge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_DB=1

# ── Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/datasources/google-sheets/callback

# ── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS / S3 ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=deskforge-uploads
S3_ENDPOINT_URL=http://localhost:9000

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@deskforge.io

# ── Encryption ───────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_KEY

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_GENERATE_PER_MINUTE=10

# ============================================================
# Frontend (apps/web/.env.local)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_CHAR_STRING
# GOOGLE_CLIENT_ID=          (same as backend)
# GOOGLE_CLIENT_SECRET=      (same as backend)
