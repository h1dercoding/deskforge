# DeskForge Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API URL (backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# App URL (this frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sandbox origin (where the sandbox iframe is served)
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string

# Google OAuth (same credentials as backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
